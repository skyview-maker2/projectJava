    footer.style.cssText = 'padding:8px 12px 12px;color:rgba(255,255,255,0.7);font-size:11px;line-height:1.5';
    footer.textContent = 'Toggle: ` or Insert • H = show • N = reset • Ultra script active';

    panel.appendChild(head);
    panel.appendChild(body);
    panel.appendChild(footer);
    root.appendChild(panel);
    document.body.appendChild(root);
    setMinimized(state.minimized);

    Object.keys(state).forEach(function (key) {
      if (buttonMap[key]) {
        setButtonState(buttonMap[key], !!state[key]);
      }
    });

    return root;
  }

  function show() {
    createPanel();
    root.style.display = 'block';
    state.open = true;
    setMinimized(state.minimized);
  }

  function hide() {
    if (!root) return;
    root.style.display = 'none';
    state.open = false;
  }

  function toggle() {
    if (!root) {
      show();
      return;
    }
    root.style.display = root.style.display === 'none' ? 'block' : 'none';
    state.open = root.style.display !== 'none';
  }

  var api = {
    show: show,
    hide: hide,
    toggle: toggle,
    open: show,
    close: hide,
    destroy: function () {
      if (root && root.parentNode) root.parentNode.removeChild(root);
      root = null;
      panel = null;
      if (window.__externalModMenu === api) delete window.__externalModMenu;
    },
    state: state,
    getGame: getGame
  };

  window.__externalModMenu = api;
  createPanel();
  installKeyboardShortcuts();

  if (!loopStarted) {
    loopStarted = true;
    requestAnimationFrame(runtimeLoop);
  }

  setInterval(function () {
    patchGameHooks();

    if (state.ballRain) {
      var g = getGame();
      if (g && g.shoot) {
        for (var i = 0; i < 4; i += 1) {
          safeCall(function () {
            g.shoot();
          });
        }
      }
    }
  }, 180);
})();
